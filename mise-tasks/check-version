#!/usr/bin/env bash
#MISE description="Reinstall python environment, lint and test with the given Python version"
#USAGE arg "<python_version>" help="Python version to check, e.g. 3.11"
set -euo pipefail

export MISE_PYTHON_VERSION="${usage_python_version:?}"

echo "Checking python ${MISE_PYTHON_VERSION}..."
rm -rf .venv
mise install
poetry install
mise run lint
mise run test
